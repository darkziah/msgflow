{
	"name": "msgflow",
	"version": "0.1.0",
	"description": "Unified inbox for Facebook Messenger and email (Front/Missive-style)",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo dev",
		"dev:web": "turbo dev --filter=@msgflow/web",
		"dev:worker": "turbo dev --filter=@msgflow/worker",
		"build": "turbo build",
		"lint": "biome lint .",
		"test": "turbo test",
		"format": "biome format . --write"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"bun-types": "latest",
		"turbo": "^2.6.3"
	},
	"peerDependencies": {
		"typescript": "^5.8.3"
	}
}
